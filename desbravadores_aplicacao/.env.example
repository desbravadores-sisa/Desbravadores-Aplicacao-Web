# Copie para .env na pasta do package.json.
# URL pública da API. A porta padrão do Spring Boot é 8080.
# Se iniciar a API em outra porta (ex.: 8081), ajuste esta URL.
VITE_API_URL=http://localhost:8080

# Variáveis VITE_* são públicas no navegador: nunca adicione senhas,
# credenciais SMTP, tokens privados ou JWT_SECRET neste arquivo/front-end.
